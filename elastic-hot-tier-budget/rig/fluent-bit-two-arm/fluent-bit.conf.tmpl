# Two-arm variant of the slim config. Arm A as in fluent-bit-slim: every line to the Receiver, returned
# records to tenx-app / tenx-tierdown on cluster A. Arm B: a copy of every line, before the Receiver, to
# cluster B by a rule fixed before the run (render-fb-two-arm.py fills @TOP_HALF@): the services that made
# the top half of bytes in the first 20 minutes go to native-overflow, every other service to native-app.
# No raw copy (lines in = Fluent Bit's input counter); the local copies of returned records keep only
# container, times, hash, route, utf8Size, level, name, lines.
# Rig Fluent Bit pipeline (Elastic hot-tier run).
#   replay (Forward, tag app.replay) -> Receiver (tenx:24224)
#   Receiver (:24225, Tag_Prefix tenx.) -> split by routeState -> pass / offload / tier_down / other
#   tier_down goes to the tenx-tierdown alias, pass and other to tenx-app, as the MCP's
#   Elastic recipe says ("Point the forwarder at the tenx-tierdown alias for events where
#   routeState == tier_down, and at tenx-app for everything else"); offload stays local.
# routeState is kept on the record: the recipe maps it as keyword in both templates.

[SERVICE]
    Flush        1
    Log_Level    info
    Grace        10
    HTTP_Server  On
    HTTP_Listen  0.0.0.0
    HTTP_Port    2020

[INPUT]
    Name        forward
    Listen      0.0.0.0
    Port        24224
    Buffer_Max_Size   16M
    Buffer_Chunk_Size 1M

[FILTER]
    Name    lua
    Match   app.*
    script  /fluent-bit/etc/rig/rig.lua
    call    prep

[FILTER]
    Name                  rewrite_tag
    Match                 app.*
    Rule                  $kubernetes['container_name'] ^(@TOP_HALF@)$ armb.overflow true
    Rule                  $kubernetes['container_name'] ^.*$           armb.normal   true
    Emitter_Name          armb_emitter
    Emitter_Mem_Buf_Limit 64M

[OUTPUT]
    Name                        forward
    Match                       app.*
    Host                        tenx
    Port                        24224
    Retry_Limit                 False
    Workers                     1
    net.max_worker_connections  1
    net.keepalive               on
    net.keepalive_max_recycle   100000000
    net.keepalive_idle_timeout  300

[INPUT]
    Name        forward
    Listen      0.0.0.0
    Port        24225
    Tag_Prefix  tenx.
    Buffer_Max_Size   16M
    Buffer_Chunk_Size 1M

[FILTER]
    Name    lua
    Match   tenx.*
    script  /fluent-bit/etc/rig/rig.lua
    call    route

[FILTER]
    Name    rewrite_tag
    Match   tenx.*
    Rule    $_route ^offload$   routed.offload   true
    Rule    $_route ^tier_down$ routed.tier_down true
    Rule    $_route ^pass$      routed.pass      true
    Rule    $_route ^other$     routed.other     true

[FILTER]
    Name        record_modifier
    Match       routed.*
    Remove_key  _route

[OUTPUT]
    Name    file
    Match   routed.pass
    Path    /data
    File    pass.txt
    Format   template
    Template {service}|{fb_ts}|{rb_ts}|{tenx_hash}|{routeState}|{utf8Size}|{severity_level}|{message_pattern}|{_lines}

[OUTPUT]
    Name    file
    Match   routed.offload
    Path    /data
    File    offload.txt
    Format   template
    Template {service}|{fb_ts}|{rb_ts}|{tenx_hash}|{routeState}|{utf8Size}|{severity_level}|{message_pattern}|{_lines}

[OUTPUT]
    Name    file
    Match   routed.tier_down
    Path    /data
    File    tier_down.txt
    Format   template
    Template {service}|{fb_ts}|{rb_ts}|{tenx_hash}|{routeState}|{utf8Size}|{severity_level}|{message_pattern}|{_lines}

[OUTPUT]
    Name    file
    Match   routed.other
    Path    /data
    File    other.txt
    Format   template
    Template {service}|{fb_ts}|{rb_ts}|{tenx_hash}|{routeState}|{utf8Size}|{severity_level}|{message_pattern}|{_lines}

[OUTPUT]
    Name               es
    Match              routed.tier_down
    Host               es-hot
    Port               9200
    Index              tenx-tierdown
    Logstash_Format    Off
    Suppress_Type_Name On
    Replace_Dots       On
    Trace_Error        On
    Buffer_Size        2MB
    Retry_Limit        False

[OUTPUT]
    Name               es
    Match_Regex        ^routed\.(pass|other)$
    Host               es-hot
    Port               9200
    Index              tenx-app
    Logstash_Format    Off
    Suppress_Type_Name On
    Replace_Dots       On
    Trace_Error        On
    Buffer_Size        2MB
    Retry_Limit        False

[OUTPUT]
    Name               es
    Match              armb.overflow
    Host               es-hot-b
    Port               9200
    Index              native-overflow
    Logstash_Format    Off
    Suppress_Type_Name On
    Replace_Dots       On
    Trace_Error        On
    Buffer_Size        2MB
    Retry_Limit        False

[OUTPUT]
    Name               es
    Match              armb.normal
    Host               es-hot-b
    Port               9200
    Index              native-app
    Logstash_Format    Off
    Suppress_Type_Name On
    Replace_Dots       On
    Trace_Error        On
    Buffer_Size        2MB
    Retry_Limit        False
