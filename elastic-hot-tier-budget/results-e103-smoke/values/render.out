{
 "image": "local/edge-10x:e103",
 "args": [
  "@run/input/forwarder/fluentbit",
  "@apps/receiver",
  "symbolMessageHashField",
  "tenx_hash",
  "outputEncodeField",
  "fullText(\"tenx_hash\",\"routeState\",\"message_pattern\",\"severity_level\",\"utf8Size\")"
 ],
 "env_applied": [
  "TENX_AIRGAPPED",
  "GH_ENABLED",
  "GH_REPO",
  "GH_BRANCH"
 ],
 "env_left_out": [],
 "env_from_shell_by_name": [
  "GH_TOKEN"
 ],
 "policy_git": {
  "repo": "log-10x/config",
  "branch": "test/elastic-hot-tier-policy",
  "tokenSecretName": "log10x-policy-git"
 },
 "notes": []
}
